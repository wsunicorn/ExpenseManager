<?xml version="1.0" encoding="utf-8"?>
<!--
  Bố cục widget 4×2. Đặc tả: 01_DAC_TA_TINH_NANG.md mục I.

  Dùng màu và cỡ chữ cứng chứ không lấy từ theme của app: widget chạy trong
  tiến trình launcher, không truy cập được ThemeData của Flutter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tổng tài sản"
        android:textSize="11sp"
        android:textColor="#99FFFFFF" />

    <TextView
        android:id="@+id/widget_total_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/widget_month_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="#CCFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_today_expense"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widget_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Ghi nhanh"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/widget_button" />
    </LinearLayout>
</LinearLayout>
